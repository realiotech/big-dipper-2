# This is a sample .env file for use in local development.
# Duplicate this file as .env in the root of the project
# and update the environment variables to match your
# desired config
#
# See the README for full descriptions of each of the
# available configurations.

NEXT_PUBLIC_GRAPHQL_URL=http://localhost:8080/v1/graphql
NEXT_PUBLIC_GRAPHQL_WS=ws://localhost:8080/v1/graphql
NEXT_PUBLIC_SUBGRAPHQL_URL=http://localhost:8080/v1/graphql
HASURA_ADMIN_SECRET=your_hasura_admin_secret_here
NODE_ENV=development
PORT=3000
NEXT_PUBLIC_RPC_API=http://localhost:26657
NEXT_PUBLIC_RPC_WEBSOCKET=http://localhost:26657/websocket
NEXT_PUBLIC_CHAIN_TYPE=testnet
NEXT_PUBLIC_RPC_URL=https://realio-testnet.rpc.decentrio.ventures:443
NEXT_PUBLIC_API_URL=https://realio-testnet.api.decentrio.ventures:443
NEXT_PUBLIC_JSON_RPC_URL=http://realio-testnet.json-rpc.decentrio.ventures/
PRICE_API_KEY=your_price_api_key_here
PRICE_API_URL=https://asset-api.realio.network/prices

# Compromised-wallet monitor (server-only; never prefix secrets with NEXT_PUBLIC_)
# MONITOR_DB=.monitor-data/monitor.db
# MONITOR_WATCHLIST_FILE=src/configs/compromised_wallets.json
# MONITOR_HASURA_URL=https://hasura.realio.network/v1/graphql
