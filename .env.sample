# MONITOR_BASIC_AUTH_USER=
# MONITOR_BASIC_AUTH_PASSWORD=
# MONITOR_PUBLIC=false
# MONITOR_WEBHOOK_URL=
# MONITOR_TAIL_INTERVAL_MS=60000
# MONITOR_SWEEP_INTERVAL_MS=900000
# MONITOR_SNAPSHOT_RETENTION=96
# MONITOR_ALERT_RETENTION_DAYS=30
# MONITOR_ACTIVITY_START_HEIGHT=19565000
# MONITOR_CHAIN_RESTART_HEIGHT=19573267
